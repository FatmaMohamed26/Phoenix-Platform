# انسخ هذا الملف باسم ".env" (بدون example) واملأ البيانات ثم أعد تشغيل السيرفر
# ----- إرسال البريد الإلكتروني (لاستعادة كلمة المرور) -----
# مثال Gmail: فعّلي التحقق بخطوتين ثم أنشئي "كلمة مرور التطبيقات" (App Password) واستخدميها هنا
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.platform@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# الاسم الظاهر للمرسل (اختياري)
SMTP_FROM=your.platform@gmail.com

# ----- رموز التفعيل لإنشاء حساب معالج نفسي أو أدمن (غيّريها!) -----
THERAPIST_CODE=PHX-THERAPIST-2026
ADMIN_CODE=PHX-ADMIN-2026
